FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      ITHACAdict;
}

thermalConductivity 383.0; 
density             8940.0; 
specificHeat        390.0; 
heatTranferCoeff    5.66e4; 
Tf                  350.0;
a		    150;
b		    200;
c		    300;
d		    14;
timeBasisType       constant;
maxFrequency        0.1;

shapeParameter      .6;
NmodesT0            20;
NmagicPoints        18;
T0projectionTol     1e-12;
SVDtol              1e-8;
PODnorm             L2;
noiseLevel          0.01;

linearTimeBasis     1;



//Test to perform
addNoise    1;
parameterizedBC_unsteadyTest 0;
parameterizedBC_unsteadyTestFULL 1;
parameterizedBC_NoiseTest 0;

