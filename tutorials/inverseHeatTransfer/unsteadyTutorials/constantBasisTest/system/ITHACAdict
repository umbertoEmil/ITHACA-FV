FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      ITHACAdict;
}

thermalConductivity 383.0; 
density             8940.0; 
specificHeat        390.0; 
heatTranferCoeff    5.66e4; 
Tf                  350.0;
//a		    150;
//b		    200;
//c		    300;
//d		    14;
a		    1100;
b		    1200;
c		    3000;
d		    0;
maxFrequency        0.1;

shapeParameter      .6;
NmodesT0            20;
NmagicPoints        18;
T0projectionTol     1e-12;
SVDtol              1e-8;
PODnorm             L2;
noiseLevel          0.05;

spaceBasisType      pod;
NpodBasis           10;
Nimplicit           10;

timeGrad            0.;

linearTimeBasis     1;
weightsInterpolation     0;



//Test to perform
reconstructionTest      1;
thermocoupleReconstructionTest 1;
inverseTest             1;

